{
  "id": "root",
  "type": "row",
  "titlebar": "none",
  "traffic_lights": [
    18,
    21
  ],
  "background": "canvas",
  "padding": 6,
  "gap": 6,
  "terminal_padding": [
    18,
    12
  ],
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "size": {
        "px": 230
      },
      "min": 44,
      "max": 480,
      "padding": [
        0,
        4
      ],
      "resizable": false,
      "children": [
        {
          "id": "brand",
          "type": "block",
          "size": {
            "px": 44
          },
          "window_drag": true,
          "content": {
            "mod": "workspace-chrome"
          }
        },
        {
          "id": "sidebar-lists",
          "type": "column",
          "resizable": false,
          "children": [
            {
              "id": "spaces",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 80,
              "content": {
                "mod": "spaces"
              }
            },
            {
              "id": "agents",
              "type": "block",
              "size": {
                "weight": 1
              },
              "min": 90,
              "content": {
                "mod": "agents"
              }
            }
          ]
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "size": {
            "px": 40
          },
          "content": {
            "mod": "workspace-chrome",
            "props": {
              "footer": true
            }
          }
        }
      ]
    },
    {
      "id": "work",
      "type": "column",
      "background": "surface",
      "radius": 14,
      "resizable": false,
      "children": [
        {
          "id": "tabs",
          "type": "block",
          "size": {
            "px": 39
          },
          "window_drag": true,
          "content": {
            "mod": "tabs"
          }
        },
        {
          "id": "main",
          "type": "block",
          "padding": 6,
          "content": {
            "tab": "active",
            "pane": {
              "gap": 6,
              "radius": 10,
              "background": "background",
              "lone": false,
              "border": {
                "width": 1,
                "color": "border"
              },
              "focus": {
                "width": 1,
                "color": "accent"
              },
              "header": {
                "content": {
                  "mod": "pane"
                },
                "height": 30,
                "position": "top",
                "reveal": "always"
              }
            }
          }
        }
      ]
    },
    {
      "id": "panel",
      "type": "column",
      "hidden": true,
      "size": {
        "px": 680
      },
      "min": 330,
      "max": 900,
      "children": [
        {
          "id": "panel-body",
          "type": "stack",
          "active": "files",
          "children": [
            {
              "id": "files",
              "type": "block",
              "content": {
                "mod": "files"
              }
            },
            {
              "id": "changes",
              "type": "block",
              "content": {
                "mod": "changes"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "tabs-column",
      "type": "block",
      "hidden": true,
      "size": {
        "px": 330
      },
      "min": 330,
      "max": 480,
      "content": {
        "mod": "tabs-column"
      }
    }
  ]
}
