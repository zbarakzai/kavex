+}
+
+/// HERDR: the evaluated entry of a load, kept for the next load of the same
+/// unchanged application once no copy holds this one any more.
+///
+/// QuickJS frees an evaluated module only with its context, so evaluating a
+/// fresh generation per load (every overlay open) kept each one's bytecode and
+/// JIT feedback for the life of the app, and each open got slower and bigger.
+struct ReusableApp {
+    modules: ApplicationModules,
+    entry: std::path::PathBuf,
+    class: Persistent<Object<'static>>,
+    /// Alive while a copy holds this generation; reuse waits until it is not,
+    /// so copies alive at the same time keep their own modules.
+    live: Weak<ApplicationModuleRegistration>,
+}
+
+impl ReusableApp {
+    fn serves(
+        &self,
+        entry: &Path,
+        dependencies: &BTreeMap<String, MaterializedDependency>,
+    ) -> bool {
+        self.entry == entry
+            && self.modules.dependencies.len() == dependencies.len()
+            && self
+                .modules
+                .dependencies
+                .iter()
+                .zip(dependencies)
+                .all(|((a, x), (b, y))| a == b && x.root == y.root && x.entry == y.entry)
+            && self
+                .modules
+                .files
+                .borrow()
+                .iter()
+                .all(|(path, stamp)| stamp.is_some() && file_stamp(path) == *stamp)
+    }
 }
 
