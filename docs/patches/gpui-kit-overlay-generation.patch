+    // HERDR: reopening an unchanged application reuses its evaluated modules.
+    #[test]
+    fn a_released_unchanged_application_reuses_its_modules() {
+        let runtime = ShellRuntime::new_isolated().expect("runtime");
+        let root = std::env::temp_dir().join(format!(
+            "gpui-shell-reused-module-generation-{}",
+            std::process::id()
+        ));
+        let _ = std::fs::remove_dir_all(&root);
+        std::fs::create_dir_all(&root).expect("application directory");
+        std::fs::write(
+            root.join("main.js"),
+            "import { label } from './feature.js';\n\
+             export default class Panel { static label() { return label; } }",
+        )
+        .expect("entry module");
+        std::fs::write(root.join("feature.js"), "export const label = 'first';")
+            .expect("first feature");
+        let label = |view_type: &super::ViewType| {
+            runtime
+                .with_js(|ctx| {
+                    let class = view_type.value.clone().restore(ctx)?;
+                    let label: rquickjs::Function = class.get("label")?;
+                    label.call::<_, String>(())
+                })
+                .expect("label")
+        };
+        let generation =
+            |view_type: &super::ViewType| view_type.module_lease.as_ref().unwrap().generation();
+
+        let first = runtime.load_app(&root, "main.js").expect("first load");
+        let first_generation = generation(&first);
+        // Alive at the same time: its own modules, as before.
+        let beside = runtime.load_app(&root, "main.js").expect("concurrent load");
+        assert_ne!(generation(&beside), first_generation);
+        drop(beside);
+        drop(first);
+        assert_eq!(runtime.app_modules.registration_count(), 0);
+
+        let again = runtime.load_app(&root, "main.js").expect("reopen");
+        assert!(
+            [first_generation, first_generation + 1].contains(&generation(&again)),
+            "a released unchanged load is reused"
+        );
+        assert!(again.application.as_ref().unwrap().is_active());
+        assert_eq!(runtime.app_modules.registration_count(), 1);
+        drop(again);
+
+        std::fs::write(root.join("feature.js"), "export const label = 'second one';")
+            .expect("second feature");
+        let changed = runtime.load_app(&root, "main.js").expect("changed load");
+        assert!(generation(&changed) > first_generation + 1, "a changed import loads fresh");
+        assert_eq!(label(&changed), "second one");
+        drop(changed);
+        let _ = std::fs::remove_dir_all(root);
+    }
